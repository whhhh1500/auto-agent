# Model configuration is administered in the Console and persisted in the
# database. Legacy HARNESS_LLM_* variables are read only for a one-time import
# when the LLM row is absent; they are not a normal deployment configuration.

# Example HTTP server.
HARNESS_SERVER_PORT=8080

# Deployment safety mode: dev (default), demo, or production. Production
# requires HARNESS_MASTER_KEY and rejects development header authentication.
# HARNESS_MODE=production
# HARNESS_MASTER_KEY=<32-byte base64-or-hex-key-from-a-secret-manager>
# HARNESS_DEV_HEADER_AUTH=true

# Shared database. The server loads this .env file from its working directory;
# existing process environment variables win. Leave both unset for the zero-
# configuration SQLite path: ./data/core.db and ./data/resources.
# HARNESS_DATABASE_TYPE=sqlite
# HARNESS_DATA_DIR=./data
# Session store selection: database configuration is authoritative. With no
# stored configuration, sessions use the embedded SQL database and resources
# use HARNESS_DATA_DIR/resources.
# HARNESS_SQLITE_PATH=./data/core.db

# Shared SQL control/session database. Select PostgreSQL explicitly; a DSN by
# itself does not switch database type. Do not set HARNESS_SQLITE_PATH when
# HARNESS_DATABASE_TYPE=postgres. Require TLS in production DSNs.
# HARNESS_DATABASE_TYPE=postgres
# HARNESS_POSTGRES_DSN=postgres://user:password@db.example.com:5432/harness?sslmode=require
# SQLite defaults: max open/idle 1. PostgreSQL defaults: max open 20, idle 10.
# HARNESS_DB_MAX_OPEN_CONNS=20
# HARNESS_DB_MAX_IDLE_CONNS=10
# HARNESS_DB_CONN_MAX_LIFETIME=30m
# HARNESS_DB_CONN_MAX_IDLE_TIME=5m

# Model, S3, and business capability configuration is managed by the Console
# and persisted in the database. Advanced operational environment variables
# are documented in docs/deployment.md.
