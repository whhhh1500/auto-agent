  "queries": [
    {
      "name": "scope_inheritance_excludes_sibling",
      "information_need": "Find the retention protocol applicable to Alice, including global and product policy, without exposing Bob's sibling-private record.",
      "scope": [{"kind":"global","id":"global"},{"kind":"product","id":"platform"},{"kind":"tenant","id":"acme"},{"kind":"user","id":"alice"}],
      "query": "retention protocol",
      "top_k": 5,
      "qrels": ["global-retention","product-retention","alice-retention"],
      "allowed_scopes": ["global:global","global:global/product:platform","global:global/product:platform/tenant:acme/user:alice"],
      "forbidden_ids": ["bob-private-retention"],
      "expected_ids": ["global-retention","product-retention","alice-retention","finance-retention","ops-retention"]
    },
    {
      "name": "tag_any_match_excludes_other_tag",
      "information_need": "Find the finance-tagged invoice retention schedule; a request with finance plus an absent tag must retain the contract's any-tag behavior and exclude the ops-only record.",
      "scope": [{"kind":"global","id":"global"},{"kind":"product","id":"platform"},{"kind":"tenant","id":"acme"},{"kind":"user","id":"alice"}],
      "query": "invoice retention",
      "tags": ["finance", "absent"],
      "top_k": 5,
      "qrels": ["finance-retention"],
      "allowed_scopes": ["global:global/product:platform"],
      "forbidden_ids": ["ops-retention"],
      "expected_ids": ["finance-retention"]
    },
    {
      "name": "short_query_with_long_distractor",
      "information_need": "Locate Alice's delta deployment token. The product-level document only mentions the short token amid unrelated mineral-like noise and is not relevant to this need.",
      "scope": [{"kind":"global","id":"global"},{"kind":"product","id":"platform"},{"kind":"tenant","id":"acme"},{"kind":"user","id":"alice"}],
      "query": "delta",
      "top_k": 5,
      "qrels": ["short-delta-target"],
      "allowed_scopes": ["global:global/product:platform","global:global/product:platform/tenant:acme/user:alice"],
      "expected_ids": ["long-delta-distractor","short-delta-target"]
    },
    {
      "name": "semantic_qrel_without_lexical_overlap",
      "information_need": "Find Alice's record describing when an invoice is due. The billing due-date record is relevant even though it shares no exact keyword with the query.",
      "scope": [{"kind":"global","id":"global"},{"kind":"product","id":"platform"},{"kind":"tenant","id":"acme"},{"kind":"user","id":"alice"}],
      "query": "invoice deadline",
      "top_k": 5,
      "qrels": ["semantic-billing-date"],
      "allowed_scopes": ["global:global","global:global/product:platform","global:global/product:platform/tenant:acme/user:alice"],
      "expected_ids": ["finance-retention","ops-retention"]
    },
    {
      "name": "cjk_fullwidth_punctuation_without_lexical_overlap",
      "information_need": "Find Alice's receipt-retention evidence. The Chinese fullwidth punctuation record is relevant and is matched by the fixed CJK/fullwidth delimiter tokenizer.",
